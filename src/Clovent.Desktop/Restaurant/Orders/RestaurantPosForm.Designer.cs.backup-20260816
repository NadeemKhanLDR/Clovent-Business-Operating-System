    // The styling helpers this file used to call from InitializeComponent are
    // gone: ADR-007 forbids them there, because the Designer's CodeDom parser
    // abandons the whole method at the first one. Every call site above is now
    // written out in full. StyleCategoryButton survives - moved to
    // RestaurantPosForm.cs, where it belongs - because the category buttons
    // built from the menu at runtime still need it; the rest had no runtime
    // caller and were deleted rather than left as dead code.

    private void LineGridView_RowStyle(object sender, RowStyleEventArgs e)
    {
        if (_lineGridView.GetRow(e.RowHandle) is not OrderLineRow row)
        {
            return;
        }

        if (row.IsVoided)
        {
            e.Appearance.FontStyleDelta = FontStyle.Strikeout;
            e.Appearance.ForeColor = NeutralColor;
            e.Appearance.Options.UseFont = true;
            e.Appearance.Options.UseForeColor = true;
        }
        else if (row.IsPriceOverridden)
        {
            e.Appearance.ForeColor = WarningColor;
            e.Appearance.Options.UseForeColor = true;
        }
    }

    private void UpdateBillEmptyState(bool isEmpty)
    {
        _billEmptyLabel.Visible = isEmpty;
        if (isEmpty)
        {
            _billEmptyLabel.BringToFront();
        }
    }

