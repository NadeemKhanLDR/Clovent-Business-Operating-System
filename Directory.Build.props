<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Clovent.Desktop' or '$(MSBuildProjectName)' == 'Clovent.Installer.Provisioner'">
    <!-- Select patched .NET 10 runtime to remediate GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7 for shipped executables -->
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
  </PropertyGroup>
</Project>
